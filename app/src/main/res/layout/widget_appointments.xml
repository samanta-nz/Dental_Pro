<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#16161E"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_clinic_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="دنتال‌پرو"
        android:textColor="#FF9F0A"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="end" />

    <TextView
        android:id="@+id/widget_today_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="امروز: ۰ نوبت"
        android:textColor="#F2F2F7"
        android:textSize="12sp"
        android:gravity="end" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#33FF9F0A" />

    <TextView
        android:id="@+id/widget_appt_line_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#F2F2F7"
        android:textSize="11sp"
        android:gravity="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_appt_line_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text=""
        android:textColor="#F2F2F7"
        android:textSize="11sp"
        android:gravity="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_appt_line_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text=""
        android:textColor="#F2F2F7"
        android:textSize="11sp"
        android:gravity="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="نوبتی برای امروز ثبت نشده"
        android:textColor="#8A8A93"
        android:textSize="11sp"
        android:gravity="end" />

</LinearLayout>
